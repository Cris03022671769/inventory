generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  price     Float
  dayItems  DayItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Day {
  id            Int         @id @default(autoincrement())
  date          DateTime    @unique
  items         DayItem[]
  cashEntries   CashEntry[]
  expenses      Expense[]
  totalSales    Float
  totalExpenses  Float
  expectedCash  Float
  totalCash     Float
  difference    Float
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model DayItem {
  id          Int      @id @default(autoincrement())
  day         Day      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  dayId       Int
  product     Product? @relation(fields: [productId], references: [id])
  productId   Int?
  productName String
  unitPrice   Float
  initialQty  Int
  movementQty Int      @default(0)
  finalQty    Int
  soldQty     Int
  amount      Float
  createdAt   DateTime @default(now())
}

model CashEntry {
  id        Int      @id @default(autoincrement())
  day       Day      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  dayId     Int
  bill      Int
  quantity  Int
  amount    Float
  createdAt DateTime @default(now())
}

model Expense {
  id        Int      @id @default(autoincrement())
  day       Day      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  dayId     Int
  concept   String
  amount    Float
  createdAt DateTime @default(now())
}
